# Server-only Edge Function secrets. Never prefix these with EXPO_PUBLIC_.
SMS_FALLBACK_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-server-secret
TWILIO_FROM_NUMBER=+15551234567

# Use a random value of at least 24 characters. Store the same value in
# Supabase Vault for the scheduled pg_net request.
ESCALATION_CRON_SECRET=replace-with-a-long-random-secret
ESCALATION_AFTER_SECONDS=90
